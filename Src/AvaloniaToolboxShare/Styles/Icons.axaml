			</Template>
		</Setter>
	</Style>

	<Style Selector="MenuItem.HelpInfo">
		<Setter Property="Icon">
			<Template>
				<PathIcon Data="{StaticResource HelpInfoIconData}"/>
			</Template>
		</Setter>
	</Style>

	<!-- Button -->

	<Style Selector="Button.Edit">
		<Setter Property="Content">
			<Template>
				<PathIcon Data="{StaticResource FileEditIconData}" />
			</Template>
		</Setter>
	</Style>

	<Style Selector="RadioButton.Users">
		<Setter Property="Content">
			<Template>
				<PathIcon Data="{StaticResource ViewUsersIconData}"/>
			</Template>
		</Setter>
	</Style>

	<Style Selector="RadioButton.Groups">
		<Setter Property="Content">
			<Template>
				<PathIcon Data="{StaticResource ViewGroupsIconData}"/>
			</Template>
		</Setter>
	</Style>

	<Style Selector="RadioButton.Members">
		<Setter Property="Content">
			<Template>
				<PathIcon Data="{StaticResource ViewMembersIconData}"/>
			</Template>
		</Setter>
	</Style>

	<Style Selector="Button.Help">
		<Setter Property="Content">
			<Template>
				<PathIcon Data="{StaticResource HelpHelpIconData}" />
			</Template>
		</Setter>
	</Style>

	<Style Selector="Button.Info">
		<Setter Property="Content">
			<Template>
				<PathIcon Data="{StaticResource HelpInfoIconData}" />
			</Template>
		</Setter>
	</Style>

	<!-- CommandBarButton -->

	<Style Selector="CommandBarButton.Edit">
		<Setter Property="Icon">
			<Template>
				<PathIcon Data="{StaticResource FileEditIconData}" />
			</Template>
		</Setter>
	</Style>

	<Style Selector="CommandBarToggleButton.Users">
		<Setter Property="Icon">
			<Template>
				<PathIcon Data="{StaticResource ViewUsersIconData}"/>
			</Template>
		</Setter>
	</Style>

	<Style Selector="CommandBarToggleButton.Groups">
		<Setter Property="Icon">
			<Template>
				<PathIcon Data="{StaticResource ViewGroupsIconData}"/>
			</Template>
		</Setter>
	</Style>

	<Style Selector="CommandBarToggleButton.Members">
		<Setter Property="Icon">
			<Template>
				<PathIcon Data="{StaticResource ViewMembersIconData}"/>
			</Template>
		</Setter>
	</Style>

	<Style Selector="CommandBarButton.Help">
		<Setter Property="Icon">
			<Template>
				<PathIcon Data="{StaticResource HelpHelpIconData}" />
			</Template>
		</Setter>
	</Style>

	<Style Selector="CommandBarButton.Info">
