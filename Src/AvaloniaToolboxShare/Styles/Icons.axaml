    <Style Selector="MenuItem.FileEdit">
        <Setter Property="Icon">
            <Template>
                <PathIcon Data="{StaticResource FileEditIconData}"/>
            </Template>
        </Setter>
    </Style>
    
    <Style Selector="MenuItem.FileExit">
        <Setter Property="Icon">
            <Template>
                <PathIcon Data="{StaticResource FileExitIconData}"/>
            </Template>
        </Setter>
    </Style>

    <Style Selector="MenuItem.ViewUsers">
        <Setter Property="Icon">
            <Template>
                <PathIcon Data="{StaticResource ViewUsersIconData}"/>
            </Template>
        </Setter>
    </Style>

	<Style Selector="MenuItem.ViewGroups">
		<Setter Property="Icon">
			<Template>
				<PathIcon Data="{StaticResource ViewGroupsIconData}"/>
			</Template>
		</Setter>
	</Style>

	<Style Selector="MenuItem.ViewMembers">
		<Setter Property="Icon">
			<Template>
				<PathIcon Data="{StaticResource ViewMembersIconData}"/>
			</Template>
		</Setter>
	</Style>

	<Style Selector="MenuItem.StyleSystem">
		<Setter Property="Icon">
			<Template>
				<PathIcon Data="{StaticResource StyleSystemIconData}"/>
			</Template>
		</Setter>
	</Style>

	<Style Selector="MenuItem.StyleLight">
